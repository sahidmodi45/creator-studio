# Postgres. On a laptop the studio starts its own. Hosted: paste Neon's POOLED connection string here.
DATABASE_URL=postgres://localhost:5432/creator_studio

# Public address of the app. Used for invite and password links.
APP_URL=http://localhost:3100

# Long random string. Generate with: openssl rand -hex 32
APP_SECRET=

# File storage.
#   off   = no storage connected. Upload buttons say "Uploads coming soon". Use this on Netlify until Google Drive is connected.
#   local = files on this laptop's disk. Laptop only, never on Netlify.
#   s3    = any S3 service, with the S3_* values below.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Only for STORAGE_DRIVER=s3. Cloudflare R2, AWS S3 and Supabase Storage all work.
# The bucket also needs CORS allowing PUT and GET from APP_URL.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI assistant. Leave empty and the assistant page says it is not connected.
ANTHROPIC_API_KEY=

# Product name shown in the browser tab. Leave empty for "Creator Studio".
NEXT_PUBLIC_STUDIO_NAME=
